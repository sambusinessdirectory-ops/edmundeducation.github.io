[
  {
    "moduleId": "advanced-native-110",
    "text": "A trusted coordinator can act like glue when two volunteer teams need to cooperate.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "20653681e43a548b7e812f77431859b3ad6398065f1931daabf7fd3166e4cbd5"
  },
  {
    "moduleId": "advanced-native-464",
    "text": "They were building on sand by budgeting from an unverified grant estimate.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "6edf6a24da9ca30455701e4e9d88d2298d326e12d0def64ec9cd33fd57777dd9"
  },
  {
    "moduleId": "advanced-native-351",
    "text": "Rising tuition can leave capable applicants priced out of higher education.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "a67d27a9890a21d62e2d9c540cbccb649b5084163fc93dccb1d29fef68523ec6"
  },
  {
    "moduleId": "advanced-native-1586",
    "text": "The supervisor cannot hold your hand every step of the way once the research project begins.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "2c64a2e20f65e3e6fdfe36a9ebf8a2021df94e65b9c52ded5ccd080e70cbcda4"
  },
  {
    "moduleId": "advanced-native-563",
    "text": "Teaching adults online was new territory for the museum staff, so they ran a small pilot first.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "986581ffd614930c0bc0e7e276c21812a080d8d861103064e308c066fd94bb05"
  },
  {
    "moduleId": "advanced-native-1830",
    "text": "The exchange project pulled people out of their usual bubble by pairing neighbours from different streets.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "466f8653994ff68653e275d169dedc8fa068d7aad9cf8f49684014748cf066c0"
  },
  {
    "moduleId": "advanced-native-1809",
    "text": "The brochure shows the postcard version of the fishing village; the interviews tell a fuller story.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "e34e8c36e48caf488044e63cfdd9421257eacf7670ef8f09f28a1ee27b84a1ec"
  },
  {
    "moduleId": "advanced-native-208",
    "text": "The independent café may have the edge on friendliness even if the chain opens earlier.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "4667b093cb4c28af5016896eba9544bc1c6af91c4db560ff6cf3abced81bc87f"
  }
