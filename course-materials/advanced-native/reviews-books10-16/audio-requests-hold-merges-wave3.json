[
  {
    "moduleId": "advanced-native-711",
    "text": "Organisers should leave time for discussion instead of following a rigid script throughout the workshop.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "d168326da678b70d1fb36fca6c431309fd5c90b05ce0ef266b4f6ec133e45551"
  },
  {
    "moduleId": "advanced-native-156",
    "text": "A useful timetable strikes the right balance between quiet study and group discussion.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "b46efa9a801f0cb6336f2d62055acac923daaf2ff3d97867b16256d6d37d8894"
  },
  {
    "moduleId": "advanced-native-801",
    "text": "Sharing administrative work takes a lot of weight off teachers’ shoulders while leaving feedback decisions with them.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "dd39e1f98976faa1976df0fab664be5af028a8c41003314a37a8701afda40e4d"
  },
  {
    "moduleId": "advanced-native-1129",
    "text": "A challenge she can actually meet may light a fire under a student who has lost momentum.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "cea16e5854cb94fff0048ac47e7ffc5a0cb2697a2aa78760cdd1995b64346402"
  },
  {
    "moduleId": "advanced-native-1162",
    "text": "Each permit review threw curveballs at us, so we scheduled extra time for revisions.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "pronunciationOverrideVersion": "curveball-a-to-b-tearjerker-quiet-hour-v3",
    "synthesisKey": "0fd12e72723cfb7f787cb3848eb15d21a2bf8d540ccea56454bb82d0fe1eaa95"
  },
  {
    "moduleId": "advanced-native-504",
    "text": "The ground shifted under their feet when the timetable changed overnight; workers need time to adapt.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "a7980bf40ae274079f3f5180b33966d4e50cd2e5163fb15d5b6b6282d836f423"
  },
  {
    "moduleId": "advanced-native-1869",
    "text": "By booking three venues, the theatre avoids putting all its eggs in one basket.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "37601ce0f2316047c6eb68e64fbce51d537de882b688fe9bb8d0a7465e767589"
  },
  {
    "moduleId": "advanced-native-1861",
    "text": "Closing the only evening clinic without notice would pull the rug out from under local people.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "d0b6e506b4d0c7645a768f13fca7c0f37f5069c24b9a71068b6207023a22a0fd"
  },
  {
    "moduleId": "advanced-native-1806",
    "text": "Before the next appointment, five minutes of quiet may serve as a small reset button.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "6893d232d422d9df8e51135503fb1c24589b2384185fd8d7cb2c2c5e96d622db"
  },
  {
    "moduleId": "advanced-native-554",
    "text": "Public access to archived letters may widen society’s horizons about daily life in the past.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "cb06dc85ca8a282b175c54fcf98f9952b5035a359d6871ba3e9c402051fa881f"
  },
  {
    "moduleId": "advanced-native-057",
    "text": "If you hit that wall after the first month, ask for feedback before changing courses.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "89cd812764ecd4a9d606603045c83af7bfc87a0f98d3c81fc5390bd1875af481"
  },
  {
    "moduleId": "advanced-native-165",
    "text": "Parents in the waiting room are bombarded by noise from nearby renovations.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "d3450785d02a2cdce8f9a550b33ece81eb099fb211258aeeea99979e7929cab1"
  },
  {
    "moduleId": "advanced-native-897",
    "text": "The announcement fell completely flat because it offered no answers to the staff's questions.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "919de2698f26efe939225905dbd314adf3875ddb6518c13497123d9134de7275"
  },
  {
    "moduleId": "advanced-native-847",
    "text": "During the meeting, each guest was glued to a different screen instead of joining the discussion.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "19e3a272f83b2a7cc965060470de0b7108568e1a201e76c06dbd096cc79edc57"
  },
  {
    "moduleId": "advanced-native-1430",
    "text": "A flexible timetable need not force everyone into the same mould.",
    "role": "takeaway-2",
    "voice": "bf_isabella",
    "lang": "en-gb",
    "speed": 1.05,
    "synthesisKey": "4f4aa447420b43bb0b7b2888cfc18f3c95a59f644e3212b28f3ee449cd7a61e1"
  }
]
