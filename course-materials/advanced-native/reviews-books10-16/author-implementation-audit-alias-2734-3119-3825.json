      "sourceMatch": "an endless uphill climb",
      "regressionControls": "3 positive / 3 negative passed",
      "answerDerivedGlossarySpans": 6,
      "audioRequests": [
        {
          "moduleId": "advanced-native-100",
          "text": "With little funding and strong local opposition, getting the new playground approved will be an uphill battle.",
          "role": "listening",
          "voice": "af_heart",
          "lang": "en-us",
          "speed": 0.96,
          "synthesisKey": "b75b43d057f4e173b7b3ff8d013d5145a0c82a0ad7c536f93319b3eadc63ca36"
        },
        {
          "moduleId": "advanced-native-100",
          "text": "Changing the policy may be an uphill climb, so we need a clear plan.",
          "role": "speaking",
          "voice": "bm_fable",
          "lang": "en-gb",
          "speed": 0.98,
          "synthesisKey": "cbb7786c4db221ea9b0519b67ddab6c77a4fdb502efb38f02a75938e0f9cdb2d"
        },
        {
          "moduleId": "advanced-native-100",
          "text": "Securing support can be an uphill battle.",
          "role": "takeaway-1",
          "voice": "bm_fable",
          "lang": "en-gb",
          "speed": 0.98,
          "synthesisKey": "421c1362ffb476232257dd98459e0b835a29485c7cb3e2ba9083e7046e3055f3"
        },
        {
          "moduleId": "advanced-native-100",
          "text": "It was an uphill climb, but we kept working on the main obstacles.",
          "role": "takeaway-2",
          "voice": "bf_isabella",
          "lang": "en-gb",
          "speed": 1.05,
          "synthesisKey": "9b4f4f8d523f1005c7b23a5d9ea12be01c50caac5c396789d2cacf21cd641e81"
        }
      ],
