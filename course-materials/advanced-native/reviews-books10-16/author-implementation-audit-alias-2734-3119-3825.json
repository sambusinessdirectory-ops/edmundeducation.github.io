    {
      "sourceOrdinal": 3119,
      "ownerId": "advanced-native-549",
      "batchPath": "batches/batch-0526-0550.json",
      "batchSha256": "7325da52ce28275dd49337ba798af205d35fcb64a516816e6ba2700943ec03ec",
      "decisionPath": "books10-16/editorial-decisions-3072-3131.jsonl",
      "decisionSha256": "83d53f9990d20983563124fc3f4066741cb8db33c98317ace408cfefbded0f4b",
      "contentRevision": 2,
      "sourceMatch": "trapped in old habits",
      "regressionControls": "3 positive / 3 negative passed",
      "answerDerivedGlossarySpans": 6,
      "audioRequests": [
        {
          "moduleId": "advanced-native-549",
          "text": "The committee seemed stuck in old patterns, giving the same members every speaking role even after newcomers asked to contribute; it agreed to try one shared presentation with a new pair next month.",
          "role": "listening",
          "voice": "af_heart",
          "lang": "en-us",
          "speed": 0.96,
          "synthesisKey": "1ce4598a84add23960a874dac60ca08e473f4baf3912321a30491418c99c9349"
        },
        {
          "moduleId": "advanced-native-549",
          "text": "We may be trapped in old habits, so I would like to name the repeated behaviour and try one change we can review.",
          "role": "speaking",
          "voice": "bm_fable",
          "lang": "en-gb",
          "speed": 0.98,
          "synthesisKey": "63aa26812333abcd6c61daaa92f175b08b6978d0cb73f63be16747ff21dee465"
        },
        {
          "moduleId": "advanced-native-549",
          "text": "The group was stuck in old patterns of announcing decisions before listening, so it tried collecting questions first.",
          "role": "takeaway-1",
          "voice": "bm_fable",
          "lang": "en-gb",
          "speed": 0.98,
          "synthesisKey": "0029fb90c133a17a79061428f3566318df761c073a34f90eea4ac145d30a733e"
        },
        {
          "moduleId": "advanced-native-549",
          "text": "I noticed I was trapped in old habits when the same avoidable confusion returned after every meeting.",
          "role": "takeaway-2",
          "voice": "bf_isabella",
          "lang": "en-gb",
          "speed": 1.05,
          "synthesisKey": "e0aa0804a2eb90f3845c501a96372f1c5b42a0c7b2249ac61db2367fd6ff7903"
        }
      ],
      "newAudioRoles": [
        "speaking",
        "takeaway-2"
      ],
      "review": "AI author review only; independent B review pending"
    },
    {
      "sourceOrdinal": 3825,
      "ownerId": "advanced-native-100",
      "batchPath": "batches/batch-0076-0100.json",
      "batchSha256": "f2f0cdc4057f2393ad04348496e9b4c27adafde1262b855865392bc0117b6f38",
