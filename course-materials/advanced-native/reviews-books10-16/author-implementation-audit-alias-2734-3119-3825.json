      "audioRequests": [
        {
          "moduleId": "advanced-native-116",
          "text": "The unexpected award put the small library in the spotlight, and reporters began calling every day.",
          "role": "listening",
          "voice": "af_heart",
          "lang": "en-us",
          "speed": 0.96,
          "synthesisKey": "1dff6b685144df927e320ec07fd1eb4f2570fed943badeb53e7a465a2bf3b871"
        },
        {
          "moduleId": "advanced-native-116",
          "text": "After months of news coverage, she was in the public eye, but she still needed privacy.",
          "role": "speaking",
          "voice": "bm_fable",
          "lang": "en-gb",
          "speed": 0.98,
          "synthesisKey": "816c918793f002813f9bd9b252bf4a038298a2aa46ecc5e1b42e6b541990b54d"
        },
        {
          "moduleId": "advanced-native-116",
          "text": "The award put the project in the spotlight.",
          "role": "takeaway-1",
          "voice": "bm_fable",
          "lang": "en-gb",
          "speed": 0.98,
          "synthesisKey": "4e0a741d7bcbd85b6808c818c16a5496345fdfd07ae0230990fa453c749c81cf"
        },
        {
          "moduleId": "advanced-native-116",
          "text": "Being in the public eye does not mean someone welcomes every interview.",
