{"advanced-native-001":[{"text":"The new role seemed risky, so they stayed in their comfort zone.","voice":"af_heart","duration":3.72,"sha256":"5b6fbdef8b908c5cf2bbae466c56741818573fd5ed9d509b6ebee55e17f3edf2","path":"natural-english/audio/advanced/advanced-native-001-01-a46342b994dff131.mp3"},{"text":"I stayed in my comfort zone until I joined the debate club.","voice":"am_adam","duration":3.96,"sha256":"bc16fbfaf98266bebb6d6d9a878a26888b4c9ed9b32903284713f3333986194e","path":"natural-english/audio/advanced/advanced-native-001-02-8b4dc41d20d97a8a.mp3"},{"text":"They stayed in their comfort zone.","voice":"bm_fable","duration":2.76,"sha256":"1f94fbde1a98856b0550f8f2fd30597bdd0a2cb0b5029503f218bd2e4147d3a2","path":"natural-english/audio/advanced/advanced-native-001-03-55b79130c0d34594.mp3"},{"text":"She is ready to step outside her comfort zone.","voice":"bf_isabella","duration":3.072,"sha256":"ad9f2887a2f43e46211c57c7dcef486e4820d4d087ff6c217c53177b2b28ac7b","path":"natural-english/audio/advanced/advanced-native-001-04-24df0d368f4f9008.mp3"}],"advanced-native-002":[{"text":"After passing the first test, Leo began to coast along in class.","voice":"af_heart","duration":4.296,"sha256":"5d98ff73b65431ea8d834369076272e325ccdede71615f702624c878881b417b","path":"natural-english/audio/advanced/advanced-native-002-01-28dddd15e4b8168c.mp3"},{"text":"I was coasting along, so I set myself a harder goal.","voice":"am_adam","duration":3.336,"sha256":"df8f29afcba6cebb9659256206b7a7d31490402d716004a8e37ea2f6c3159401","path":"natural-english/audio/advanced/advanced-native-002-02-ae0baa0b26a2c3a1.mp3"},{"text":"We have been coasting along.","voice":"bm_fable","duration":2.52,"sha256":"70a72edd8fc68f4b1ca5e45530a34991134dfe9f625001c1dc6b3b58f32552e8","path":"natural-english/audio/advanced/advanced-native-002-03-ae9f613d74e52273.mp3"},{"text":"We cannot just coast along forever.","voice":"bf_isabella","duration":2.616,"sha256":"f9d6a87f513da472e8f161b367397458a0c44e405205d6d2e3927219d49b6ed2","path":"natural-english/audio/advanced/advanced-native-002-04-1c8759ee543bb9e6.mp3"}],"advanced-native-003":[{"text":"Missing the deadline was a wake-up call for the whole team.","voice":"af_heart","duration":3.672,"sha256":"ba339bc5754b26f7c2ed6f834ca80cc50f754f5eb83584bb9336e0fcf4bed850","path":"natural-english/audio/advanced/advanced-native-003-01-342c33ab48f502bf.mp3"},{"text":"The failed inspection was a wake-up call for our restaurant.","voice":"am_adam","duration":3.624,"sha256":"04c7ef9e36186236801259f60102ca4eda4af1d5524b832cdbf58728d91c55df","path":"natural-english/audio/advanced/advanced-native-003-02-885e01e8d4a1024b.mp3"},{"text":"It was a wake-up call for the team.","voice":"bm_fable","duration":2.976,"sha256":"51cf7d59e4fdbc5e0cedf1ae89f21b8368ccf2c1beda8b31aeb00b6f68a67eab","path":"natural-english/audio/advanced/advanced-native-003-03-75f3a8dc30fbf84d.mp3"},{"text":"That mistake was a wake-up call.","voice":"bf_isabella","duration":2.448,"sha256":"323ef06fe5ebf295adc526243aa86abd4d2502392badea21854d6bb35a2a4579","path":"natural-english/audio/advanced/advanced-native-003-04-9c7f6b6542a65b1d.mp3"}],"advanced-native-004":[{"text":"On her first day, she had to lead a meeting. Life threw her in at the deep end.","voice":"af_heart","duration":4.896,"sha256":"65167d4dc2bd598f1be97efbd0e98bbc795300243bde0a41de1246ce27c8aebc","path":"natural-english/audio/advanced/advanced-native-004-01-67bd52a9e65bb9ac.mp3"},{"text":"I was thrown in at the deep end when I had to host the event alone.","voice":"am_adam","duration":3.888,"sha256":"0750c5ec6f56f3169b93397928461cd451f88d03d606c376c254fcbdd26ee13a","path":"natural-english/audio/advanced/advanced-native-004-02-e9fd64c864e1e297.mp3"},{"text":"Life threw her in at the deep end.","voice":"bm_fable","duration":2.88,"sha256":"18e5b6a2d2438f993f6c2140aaa2e49f061a7f73e5fc8cbf69e5c6baa13f566a","path":"natural-english/audio/advanced/advanced-native-004-03-1292fb5a63321b27.mp3"},{"text":"She was thrown in at the deep end.","voice":"bf_isabella","duration":2.28,"sha256":"04001b50e285603477a0df61640d3964d82c208eb9d47847bbd101f8f15f01c2","path":"natural-english/audio/advanced/advanced-native-004-04-bec05a3df01b592a.mp3"}],"advanced-native-005":[{"text":"Her year abroad was the making of her: she became far more independent.","voice":"af_heart","duration":4.512,"sha256":"f691580af8859d234952929261f3e164458226cde1090a9941069a38e8c9f02f","path":"natural-english/audio/advanced/advanced-native-005-01-fca3e73ad3969bb9.mp3"},{"text":"Leading that project was the making of me.","voice":"am_adam","duration":2.736,"sha256":"704e79282569c5d4cdda175cfcba8c20ba18181964cd73a3a4493a389c24e32d","path":"natural-english/audio/advanced/advanced-native-005-02-30aad1b025ac1545.mp3"},{"text":"That experience was the making of her.","voice":"bm_fable","duration":3.264,"sha256":"a43ccc32d95d505a4b3d772c0cd007714ee6706dffc6387e27ae40ed19064259","path":"natural-english/audio/advanced/advanced-native-005-03-43a857e9b54f0caa.mp3"},{"text":"The challenge was the making of me.","voice":"bf_isabella","duration":2.424,"sha256":"23544cdd19814c4ffb5a01ace5a5ad887e5a05fe923fc289c248411a58a70634","path":"natural-english/audio/advanced/advanced-native-005-04-a58f29da02d07a8d.mp3"}]}
